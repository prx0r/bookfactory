# bookfactory MCP — environment for the HTTP service.
# Copy to /root/.config/bookfactory/mcp.env and chmod 600. Never commit secrets.

BOOKFACTORY_ROOT=/home/box/repos/bookfactory
BOOKFACTORY_TRANSLATIONS=/home/box/repos/translation-work
BOOKFACTORY_PY=/home/box/Documents/patala/.venv/bin/python3

# Shared secret for remote MCP clients.
#   Authorization: Bearer <token>   or   ?token=<token>
# Leave empty to run unauthenticated (localhost only).
BOOKFACTORY_MCP_TOKEN=change-me-to-a-long-random-secret
