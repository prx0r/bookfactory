[Unit]
Description=Cloudflare named tunnel for bookfactory MCP (bookfactory.sanskrit.help)
After=bookfactory-mcp.service network-online.target
Wants=bookfactory-mcp.service network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/root/.config/bookfactory/tunnel.env
ExecStart=/usr/local/bin/cloudflared tunnel run --token $TUNNEL_TOKEN
Restart=always
RestartSec=5
StandardOutput=append:/var/log/bookfactory-tunnel.log
StandardError=append:/var/log/bookfactory-tunnel.log

[Install]
WantedBy=multi-user.target
