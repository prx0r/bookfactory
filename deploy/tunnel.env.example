# Named Cloudflare Tunnel token for bookfactory.sanskrit.help
# Create once:  cloudflared tunnel create bookfactory
#   (or dashboard: Networks -> Tunnels -> Create -> Cloudflared)
# Route DNS:    CNAME bookfactory.sanskrit.help -> <tunnel-id>.cfargotunnel.com (proxied)
# Ingress:      bookfactory.sanskrit.help -> http://127.0.0.1:8932
# Copy to /root/.config/bookfactory/tunnel.env and chmod 600. Never commit.
TUNNEL_TOKEN=change-me-to-the-tunnel-token
