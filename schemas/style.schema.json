{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prx0r/bookfactory/schemas/style-1.0.json",
  "title": "Style pack",
  "description": "Presentation only — never content. thesis.style points here; owner or reader may save additional packs; gates and anatomy stay identical across styles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "name",
    "description",
    "type_stack",
    "geometry",
    "ground",
    "render"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "type_stack": {
      "type": "object",
      "required": [
        "devanagari",
        "latin"
      ],
      "properties": {
        "devanagari": {
          "type": "string"
        },
        "latin": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "geometry": {
      "type": "object",
      "required": [
        "trim"
      ],
      "properties": {
        "trim": {
          "type": "string"
        },
        "margins": {
          "type": "string"
        },
        "spread": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "ground": {
      "type": "string",
      "minLength": 1
    },
    "guide_blocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "render": {
      "type": "string",
      "minLength": 10
    },
    "owner_can_save": {
      "type": "boolean"
    },
    "cover": {
      "type": "object",
      "additionalProperties": true,
      "description": "Cover style reference/overrides; the canonical paperback cover lives in styles/cover-canonical.json"
    }
  }
}
