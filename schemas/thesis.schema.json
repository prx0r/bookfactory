{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prx0r/bookfactory/schemas/thesis-1.0.json",
  "title": "Book thesis",
  "description": "What a book IS: its claim (intro derives from this), its structure law, inclusion/exclusion rules, and its product stack. The gate enforces structure against this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "book", "title", "template", "style", "claim", "structure", "inclusion", "exclusion", "products"],
  "properties": {
    "version": {"const": "1.0"},
    "book": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "template": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Genre template this book instantiates (templates/<id>.json)"},
    "style": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Style pack in styles/ — canonical now, user-saved later"},
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "volume"],
      "description": "Set when the book is part of a numbered series (vol 1, vol 2, ...) after overflowing the template ceiling",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "volume": {"type": "integer", "minimum": 1}
      }
    },
    "claim": {"type": "string", "minLength": 80, "description": "The book's argument. The intro is derived from this + structure."},
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections", "entries_per_section", "total_entries", "sections_plan"],
      "properties": {
        "sections": {"type": "integer", "minimum": 1},
        "entries_per_section": {"type": "integer", "minimum": 1},
        "total_entries": {"type": "integer", "minimum": 1},
        "sections_plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "purpose"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
              "purpose": {"type": "string", "minLength": 3}
            }
          }
        }
      }
    },
    "inclusion": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
    "exclusion": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
    "products": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paperback", "postcard", "social", "audiobook", "chant"],
      "properties": {
        "paperback": {"$ref": "#/$defs/product"},
        "postcard": {"$ref": "#/$defs/product"},
        "social": {"$ref": "#/$defs/product"},
        "audiobook": {"$ref": "#/$defs/product"},
        "chant": {"$ref": "#/$defs/product"}
      }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "required": ["status", "spec"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "spec": {"type": "string", "minLength": 10},
        "coverage": {"type": "object"}
      },
      "additionalProperties": true
    }
  }
}
