      },
      "howto": {
        "voice": "granny",
        "voice_id": "614f8afd83f841048c040b2c6234d2c1",
        "text": "Identify the agent, direct object and adverb. What distinguishes vicitrān from vibhuḥ?",
        "chars": 86,
        "cache_key": "63627879eca997d462359fc6326333a55b20bdbd"
      }
    },
    {
      "id": "trika-13",
      "verse": {
        "voice": "verse",
        "voice_id": "4e873c37d4cb439e9bccc4dc1f633290",
        "text": "tasyaivaiṣā parā devī svarūpāmarśanotsukā",
