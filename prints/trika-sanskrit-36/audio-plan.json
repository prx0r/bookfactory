        "cache_key": "0752db64d7c2febcc9da3d38726f8b6ba949dbbf"
      }
    },
    {
      "id": "trika-27",
      "verse": {
        "voice": "verse",
        "voice_id": "4e873c37d4cb439e9bccc4dc1f633290",
        "text": "vedyavedakasaṃkṣobhe 'py asi bhaktaiḥ sudarśanaḥ",
        "chars": 48,
        "cache_key": "adf443f8429a3e567edd640cdc6cad2efdf57e62"
      },
      "howto": {
        "voice": "granny",
        "voice_id": "614f8afd83f841048c040b2c6234d2c1",
        "text": "Why is bhaktaiḥ instrumental plural rather than nominative? How is the apostrophe formed?",
