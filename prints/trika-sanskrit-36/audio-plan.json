        "chars": 82,
        "cache_key": "9a7129896adc5efe4da84299be4d596e8d3508bf"
      }
    },
    {
      "id": "trika-26",
      "verse": {
        "voice": "verse",
        "voice_id": "4e873c37d4cb439e9bccc4dc1f633290",
        "text": "anantānandasindhos te nātha tattvaṃ vidanti te",
        "chars": 46,
        "cache_key": "362e9c6d86f38b979860162ed4c7010c34472e1c"
      },
      "howto": {
        "voice": "granny",
        "voice_id": "614f8afd83f841048c040b2c6234d2c1",
        "text": "Label te¹ and te². Which one is “your”? What is the finite verb?",
