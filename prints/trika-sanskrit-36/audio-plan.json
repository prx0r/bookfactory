        "cache_key": "2b14d26e8950b0f1979c3dab7a7923c4058daba7"
      }
    },
    {
      "id": "trika-14",
      "verse": {
        "voice": "verse",
        "voice_id": "4e873c37d4cb439e9bccc4dc1f633290",
        "text": "pūrṇatvaṃ sarvabhaveṣu yasyā nālpaṃ na cādhikam",
