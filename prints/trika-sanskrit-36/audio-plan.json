        "cache_key": "708b377f5eec17577a489f61ca4396905e641db7"
      }
    },
    {
      "id": "trika-20",
      "verse": {
        "voice": "verse",
        "voice_id": "4e873c37d4cb439e9bccc4dc1f633290",
        "text": "nānāvidhavarṇānāṃ rūpaṃ dhatte yathāmalaḥ sphaṭikaḥ",
