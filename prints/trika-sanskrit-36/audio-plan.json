        "cache_key": "11b9a6395aded7cb8a6e81bc039a388093926093"
      }
    },
    {
      "id": "trika-28",
      "verse": {
        "voice": "verse",
        "voice_id": "4e873c37d4cb439e9bccc4dc1f633290",
        "text": "aviyuktāsti te tadvad ekā tvadbhaktir astu me",
        "chars": 45,
        "cache_key": "12446bf8547b8851b7d0caf6167f4166f3c6b0fe"
      },
      "howto": {
        "voice": "granny",
        "voice_id": "614f8afd83f841048c040b2c6234d2c1",
        "text": "Find two forms of √as. Which is a fact claim and which a wish?",
