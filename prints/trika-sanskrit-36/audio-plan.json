        "cache_key": "c7ea59e51e765d8a6916b3c7bc501d800da43ef0"
      }
    },
    {
      "id": "trika-16",
      "verse": {
        "voice": "verse",
        "voice_id": "4e873c37d4cb439e9bccc4dc1f633290",
        "text": "jaḍād vilakṣaṇo bodho yato na parimīyate",
