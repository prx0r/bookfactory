        "cache_key": "bb6a6cfaa0b91ad1bf8cdf980eedd5b80491176c"
      }
    },
    {
      "id": "trika-24",
      "verse": {
        "voice": "verse",
        "voice_id": "4e873c37d4cb439e9bccc4dc1f633290",
        "text": "paramaṃ yat svātantryaṃ durghaṭasaṃpādanaṃ maheśasya",
