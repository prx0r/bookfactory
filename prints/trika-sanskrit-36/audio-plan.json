        "cache_key": "2a47a15029c0178b7f80e0916eabb99aac130cfa"
      }
    },
    {
      "id": "trika-12",
      "verse": {
        "voice": "verse",
        "voice_id": "4e873c37d4cb439e9bccc4dc1f633290",
        "text": "vicitrān sṛṣṭisaṃhārān vidhatte yugapad vibhuḥ",
