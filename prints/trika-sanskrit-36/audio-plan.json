        "cache_key": "0961d0f5d75224d1d02897e9250dc71f6044ba73"
      }
    },
    {
      "id": "trika-23",
      "verse": {
        "voice": "verse",
        "voice_id": "4e873c37d4cb439e9bccc4dc1f633290",
        "text": "yat paratattvaṃ tasmin vibhāti ṣaṭtriṃśadātma jagat",
