        "cache_key": "7af6ea1c562125cc999ad3706c40655d67b8b318"
      }
    },
    {
      "id": "trika-29",
      "verse": {
        "voice": "verse",
        "voice_id": "4e873c37d4cb439e9bccc4dc1f633290",
        "text": "saṃvinmārgo 'yam āhlādaduḥkhamohais tridhā sthitaḥ",
