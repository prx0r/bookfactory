        "cache_key": "1b4a97728be7beedca74f3e5fc778bf246ad2f61"
      }
    },
    {
      "id": "trika-25",
      "verse": {
        "voice": "verse",
        "voice_id": "4e873c37d4cb439e9bccc4dc1f633290",
        "text": "advitīyā api sadā tvaddvitīyā api prabho",
