        "cache_key": "e9a8da7145268466cc2d5fcf6b35942e205a0a8b"
      }
    },
    {
      "id": "trika-30",
      "verse": {
        "voice": "verse",
        "voice_id": "4e873c37d4cb439e9bccc4dc1f633290",
        "text": "bhavadbhaktimahāvidyā yeṣām abhyāsam āgatā",
