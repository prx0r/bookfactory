        "cache_key": "c4d8738f24f7f823acc3577a30398a11ff3f2262"
      },
      "howto": {
        "voice": "granny",
        "voice_id": "614f8afd83f841048c040b2c6234d2c1",
        "text": "Underline the two examples of a+a→ā and identify yasyā as what case.",
        "chars": 68,
        "cache_key": "741e4f16d9410fd0ff563732524c8b7a49d1371b"
      }
    },
    {
      "id": "trika-15",
      "verse": {
        "voice": "verse",
        "voice_id": "4e873c37d4cb439e9bccc4dc1f633290",
