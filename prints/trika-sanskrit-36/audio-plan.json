        "cache_key": "7aa0969b16c213e0cb35408a6e77cd6af55ff193"
      }
    },
    {
      "id": "trika-22",
      "verse": {
        "voice": "verse",
        "voice_id": "4e873c37d4cb439e9bccc4dc1f633290",
        "text": "śivaśaktipātavimale dhītattve bhāti bhārūpaḥ",
